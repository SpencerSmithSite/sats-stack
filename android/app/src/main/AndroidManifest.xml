<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required in the MAIN manifest, not just debug/profile. The Flutter
         template declares INTERNET only in those two source sets, for hot
         reload, so a release build had no network access at all: every price
         fetch, xpub sync, hosted AI request and model download failed with
         errno 13. Invisible in development, because `flutter run` builds
         debug or profile. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- No CAMERA and no READ_MEDIA_IMAGES, deliberately. The receipt photo
         goes through image_picker, which uses the camera app's capture intent
         and the system photo picker — neither needs a permission. Declaring
         CAMERA makes image_picker prompt for it anyway (a manifest that lists
         it must be granted before the capture intent may be used), and
         declaring READ_MEDIA_IMAGES falls under Google Play's photo-permission
         policy, which rejects apps that only pick the odd photo. -->
    <!-- Backup rules: see res/xml/data_extraction_rules.xml. Without them the
         database went to Google Drive in plaintext, and the API keys went with
         it in a form a restored phone could not read. -->
    <application
        android:label="Sats Stack"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- No usage reports to Google. ML Kit, there for Gemini Nano, brings
             Google's data transport into every Android build, and ML Kit
             reports its usage through this "cct" backend (audit P-5). With
             the backend removed the transport has nowhere to send events,
             and drops them on the device. CI checks that the release
             manifest does not get it back. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
