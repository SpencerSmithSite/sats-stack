// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// The app's name in Finder, the menu bar and the window title, which read
// "sats_stack" while this was the template default. Safe to change: the
// sandbox container — and with it the database — follows the bundle
// identifier below, not this.
PRODUCT_NAME = Sats Stack

// The application's bundle identifier — the same as iOS's. It was the
// template's `com.satsstack.satsStack` until 2026-10-20. Changing it moves the
// app's sandbox container, so a build with the old id keeps its data under
// ~/Library/Containers/com.satsstack.satsStack; see README → "Moving macOS
// data from before the bundle id change".
PRODUCT_BUNDLE_IDENTIFIER = app.satsstack.SatsStack

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 The Sats Stack Authors. Licensed under Apache-2.0.
