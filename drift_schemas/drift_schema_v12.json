    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"label\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"xpub\" TEXT NULL, \"color\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"wallet_id\" INTEGER NOT NULL REFERENCES wallets (id), \"date\" INTEGER NOT NULL, \"description\" TEXT NOT NULL, \"amount_sats\" INTEGER NOT NULL, \"amount_fiat\" REAL NOT NULL, \"fiat_currency\" TEXT NOT NULL, \"category\" TEXT NULL, \"source\" TEXT NOT NULL, \"is_bitcoin\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_bitcoin\" IN (0, 1)), \"notes\" TEXT NULL, \"dedup_hash\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"recurring_period\" TEXT NULL, \"recurring_anchor_date\" INTEGER NULL, \"recurring_series_id\" TEXT NULL, \"is_own_transfer\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_own_transfer\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"is_system\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_system\" IN (0, 1)));"
        }
      ]
    },
